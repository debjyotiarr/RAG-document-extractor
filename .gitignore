# Data and derived artifacts — never commit real documents or databases.
# The folders themselves are kept via .gitkeep so the layout exists after cloning.
data/*
!data/vault/
data/vault/*
!data/vault/.gitkeep
*.db
*.db-wal
*.db-shm
eval/results/*
!eval/results/.gitkeep

# Local Claude Code settings
.claude/

# OS junk
.DS_Store

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/

# Generated fixture corpus (regenerate with tests/fixtures/make_fixtures.py)
tests/fixtures/corpus/
